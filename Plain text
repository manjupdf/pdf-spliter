<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Splitter & Compressor</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>PDF Splitter & Compressor</h1>

        <div class="card">
            <h2>Upload PDF</h2>
            <input type="file" id="pdfFile" accept=".pdf">
        </div>

        <div class="card">
            <h2>Page Selection</h2>

            <div class="row">
                <input type="text" id="pageRange"
                       placeholder="Example: 1-2,3-4,5">

                <input type="text" id="fileName"
                       placeholder="Example: ID Card, Aadhaar Card, Ration Card">
            </div>

            <button id="addBtn">Add</button>
        </div>

        <div class="card">
            <h2>Selected Files</h2>

            <table>
                <thead>
                    <tr>
                        <th>Page Range</th>
                        <th>File Name</th>
                    </tr>
                </thead>
                <tbody id="tableBody">

                </tbody>
            </table>
        </div>

        <div class="card">
            <h2>Options</h2>

            <label>
                <input type="checkbox" id="autoName">
                Auto Name Files (1.pdf, 2.pdf, 3.pdf...)
            </label>

            <br><br>

            <label>
                Maximum Size:
                <select id="maxSize">
                    <option value="300">300 KB</option>
                    <option value="500">500 KB</option>
                    <option value="1000">1 MB</option>
                </select>
            </label>
        </div>

        <div class="card">
            <button id="processBtn">
                Split & Compress PDF
            </button>
        </div>

        <div class="card">
            <h2>Downloads</h2>

            <div id="downloadArea">

            </div>
        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>
